<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRN | நட்பு கதை</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#020208;
    font-family:Arial,"Noto Sans Tamil",sans-serif;
    color:white;
}

/* 3D Background */
.scene{
    position:fixed;
    inset:0;
    perspective:900px;
    overflow:hidden;
    background:
      radial-gradient(circle at center,#141044 0%,#05051b 45%,#010106 100%);
}

.grid{
    position:absolute;
    width:200%;
    height:200%;
    left:-50%;
    top:55%;
    transform:rotateX(65deg);
    background:
      linear-gradient(rgba(0,255,255,.18) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,0,255,.18) 1px,transparent 1px);
    background-size:55px 55px;
    animation:gridMove 3s linear infinite;
}

@keyframes gridMove{
    from{transform:rotateX(65deg) translateY(0);}
    to{transform:rotateX(65deg) translateY(55px);}
}

/* Stars */
.stars{
    position:absolute;
    inset:0;
    background-image:
      radial-gradient(circle,white 1px,transparent 2px),
      radial-gradient(circle,#00ffff 1px,transparent 2px),
      radial-gradient(circle,#ff00ff 1px,transparent 2px);
    background-size:90px 90px,130px 130px,170px 170px;
    animation:stars 8s linear infinite;
    opacity:.7;
}

@keyframes stars{
    from{transform:translateY(0);}
    to{transform:translateY(100px);}
}

/* Hacker code */
.code{
    position:absolute;
    inset:0;
    color:#00ff99;
    opacity:.13;
    font-family:monospace;
    font-size:13px;
    line-height:22px;
    white-space:pre-wrap;
    animation:codeMove 12s linear infinite;
}

@keyframes codeMove{
    from{transform:translateY(0);}
    to{transform:translateY(-500px);}
}

/* SRN Entry */
.entry{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    z-index:10;
    background:
      radial-gradient(circle,rgba(20,0,70,.25),rgba(0,0,0,.94));
    transition:1.5s;
}

.srn{
    font-size:clamp(80px,22vw,230px);
    font-weight:900;
    letter-spacing:20px;
    color:white;
    text-shadow:
      0 0 5px #fff,
      0 0 15px #00ffff,
      0 0 35px #0088ff,
      0 0 65px #ff00ff;
    animation:
      srnIntro 2.5s ease-out,
      rgb 2s infinite alternate;
}

@keyframes srnIntro{
    0%{
        opacity:0;
        transform:scale(.1) rotateX(90deg) rotateY(90deg);
        filter:blur(30px);
    }
    60%{
        opacity:1;
        transform:scale(1.2) rotateX(-10deg) rotateY(-10deg);
    }
    100%{
        transform:scale(1) rotateX(0) rotateY(0);
    }
}

@keyframes rgb{
    from{
        text-shadow:
        0 0 5px white,
        0 0 20px #00ffff,
        0 0 50px #0088ff;
    }
    to{
        text-shadow:
        0 0 5px white,
        0 0 25px #ff00ff,
        0 0 60px #ff0088;
    }
}

.loading{
    width:280px;
    height:4px;
    background:#222;
    margin-top:25px;
    overflow:hidden;
    border-radius:10px;
    box-shadow:0 0 20px #00ffff;
}

.loading span{
    display:block;
    height:100%;
    width:0;
    background:linear-gradient(90deg,#00ffff,#ff00ff,#ffff00);
    animation:load 4s forwards;
}

@keyframes load{
    to{width:100%;}
}

.enterText{
    margin-top:18px;
    color:#00ffff;
    letter-spacing:4px;
    animation:blink .7s infinite alternate;
}

@keyframes blink{
    from{opacity:.3;}
    to{opacity:1;}
}

/* Main Story */
.story{
    position:absolute;
    inset:0;
    display:none;
    z-index:5;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:25px;
}

.card{
    width:min(900px,94vw);
    min-height:430px;
    padding:45px 30px;
    border:1px solid rgba(0,255,255,.6);
    border-radius:25px;
    background:rgba(5,5,30,.72);
    backdrop-filter:blur(12px);
    box-shadow:
      0 0 20px rgba(0,255,255,.35),
      0 0 70px rgba(255,0,255,.15),
      inset 0 0 40px rgba(0,255,255,.05);
    transform-style:preserve-3d;
    animation:card3d 6s ease-in-out infinite alternate;
}

@keyframes card3d{
    from{transform:rotateY(-2deg) rotateX(1deg);}
    to{transform:rotateY(2deg) rotateX(-1deg);}
}

.logo{
    font-size:55px;
    font-weight:bold;
    color:#fff;
    text-shadow:0 0 25px #00ffff;
    margin-bottom:10px;
}

.title{
    font-size:clamp(28px,6vw,58px);
    margin-bottom:25px;
    background:linear-gradient(
      90deg,
      #00ffff,
      #fff,
      #ff00ff,
      #ffff00,
      #00ffff
    );
    background-size:300%;
    -webkit-background-clip:text;
    color:transparent;
    animation:colorFlow 4s linear infinite;
}

@keyframes colorFlow{
    to{background-position:300%;}
}

.storyText{
    font-size:clamp(18px,3vw,28px);
    line-height:2;
    min-height:150px;
    text-shadow:0 0 12px rgba(255,255,255,.35);
}

.next{
    margin-top:25px;
    padding:13px 30px;
    border:1px solid #00ffff;
    background:transparent;
    color:#00ffff;
    border-radius:30px;
    font-size:16px;
    cursor:pointer;
    box-shadow:0 0 20px rgba(0,255,255,.25);
    transition:.3s;
}

.next:hover{
    color:white;
    background:#00ffff;
    box-shadow:0 0 35px #00ffff;
}

/* Particles */
.particle{
    position:absolute;
    width:4px;
    height:4px;
    border-radius:50%;
    background:#00ffff;
    box-shadow:0 0 15px #00ffff;
    animation:float 5s linear infinite;
}

@keyframes float{
    from{
        transform:translateY(110vh) scale(.3);
        opacity:0;
    }
    20%{opacity:1;}
    to{
        transform:translateY(-20vh) scale(1.5);
        opacity:0;
    }
}

/* End */
.end{
    display:none;
    position:absolute;
    inset:0;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    text-align:center;
    background:rgba(0,0,0,.88);
    z-index:20;
}

.end h1{
    font-size:clamp(45px,10vw,100px);
    background:linear-gradient(90deg,#00ffff,#ff00ff,#ffff00,#00ff88);
    -webkit-background-clip:text;
    color:transparent;
    animation:endGlow 2s infinite alternate;
}

@keyframes endGlow{
    from{filter:drop-shadow(0 0 5px #00ffff);}
    to{filter:drop-shadow(0 0 30px #ff00ff);}
}

.end p{
    margin-top:20px;
    font-size:20px;
    color:#ddd;
}
</style>
</head>

<body>

<div class="scene">

    <div class="stars"></div>
    <div class="grid"></div>

    <div class="code">
010101 110010 001101 101010
SYSTEM ONLINE...
ACCESS GRANTED...
SRN NETWORK CONNECTED...
FRIENDSHIP_PROTOCOL = TRUE
010101 110010 001101 101010

[ SYSTEM BOOT ]
Loading friendship memories...
Loading trust...
Loading unforgettable moments...
Connection established...

SRN // DIGITAL FRIENDSHIP NETWORK

01001001 01010010 01001111
ACCESS...
CONNECTED...
CONNECTED...
CONNECTED...
    </div>

    <!-- Particles -->
    <div class="particle" style="left:10%;animation-delay:0s"></div>
    <div class="particle" style="left:25%;animation-delay:1s"></div>
    <div class="particle" style="left:40%;animation-delay:2s"></div>
    <div class="particle" style="left:60%;animation-delay:3s"></div>
    <div class="particle" style="left:75%;animation-delay:1.5s"></div>
    <div class="particle" style="left:90%;animation-delay:2.5s"></div>

    <!-- Entry -->
    <section class="entry" id="entry">
        <div class="srn">SRN</div>

        <div class="loading">
            <span></span>
        </div>

        <div class="enterText">
            SYSTEM INITIALIZING...
        </div>
    </section>

    <!-- Story -->
    <section class="story" id="story">

        <div class="card">

            <div class="logo">SRN</div>

            <h1 class="title" id="title">
                ஒரு நட்பு... ஒரு கதை...
            </h1>

            <div class="storyText" id="storyText"></div>

            <button class="next" onclick="nextStory()">
                அடுத்தது ⚡
            </button>

        </div>

    </section>

    <!-- End -->
    <section class="end" id="end">

        <h1>SRN</h1>

        <p>
            உண்மையான நட்பு என்பது<br>
            தூரத்தை அல்ல... இதயத்தை இணைப்பது ❤️
        </p>

    </section>

</div>

<script>

/* ================================
   SRN FRIENDSHIP STORY
================================ */

const stories = [

{
 title:"ஒரு சிறிய அறிமுகம்...",
 text:"ஒரு நாள்... எந்த எதிர்பார்ப்பும் இல்லாமல் சில மனிதர்கள் இணையத்தில் சந்தித்தார்கள். அந்த சந்திப்பு ஒரு சாதாரண சந்திப்பு என்று நினைத்தார்கள்..."
},

{
 title:"நட்பு தொடங்கியது...",
 text:"சில வார்த்தைகள் பேசினார்கள்... சில சிரிப்புகளை பகிர்ந்தார்கள்... மெதுவாக அந்த அறிமுகம் ஒரு அழகான நட்பாக மாறியது."
},

{
 title:"முகம் தெரியவில்லை...",
 text:"அவர்களுக்கு ஒருவரின் முகம் கூட தெரியாமல் இருக்கலாம். ஆனால் ஒருவரின் மனதை ஒருவர் புரிந்து கொள்ளத் தொடங்கினர்."
},

{
 title:"நேரம் கடந்தது...",
 text:"நாட்கள் சென்றன... மாதங்கள் சென்றன... ஆனால் அந்த நட்பின் நினைவுகள் மட்டும் ஒவ்வொரு நாளும் புதியதாகவே இருந்தது."
},

{
 title:"சோதனை வந்தது...",
 text:"ஒரு நாள் வாழ்க்கை சில சோதனைகளை கொண்டு வந்தது. சிலர் விலகினார்கள்... ஆனால் உண்மையான நண்பர்கள் மட்டும் அருகில் இருந்தார்கள்."
},

{
 title:"அதுதான் உண்மையான நட்பு...",
 text:"சந்தோஷத்தில் மட்டும் அருகில் இருப்பவன் நண்பன் அல்ல... கஷ்டமான நேரத்திலும் 'நான் இருக்கிறேன்' என்று சொல்லாமல் இருந்தும் துணையாக இருப்பவன்தான் உண்மையான நண்பன்."
},

{
 title:"SRN...",
 text:"இந்த மூன்று எழுத்துகளுக்குள் ஒரு பெயர் மட்டும் இல்லை... எண்ணற்ற நினைவுகள், சிரிப்புகள், நம்பிக்கை மற்றும் மறக்க முடியாத ஒரு நட்பு இருக்கிறது."
},

{
 title:"கடைசி வரி...",
 text:"வாழ்க்கை எவ்வளவு தூரம் அழைத்துச் சென்றாலும்... உண்மையான நட்பு ஒருபோதும் முடிவதில்லை. அது நினைவுகளாகவும் இதயமாகவும் தொடர்ந்து வாழும்."
}

];

let current = 0;

const entry = document.getElementById("entry");
const story = document.getElementById("story");
const title = document.getElementById("title");
const storyText = document.getElementById("storyText");
const end = document.getElementById("end");

/* Entry animation */
setTimeout(() => {

    entry.style.opacity = "0";

    setTimeout(() => {
        entry.style.display = "none";
        story.style.display = "flex";
        showStory();
    },1200);

},5000);


/* Typewriter */
function typeText(text){

    storyText.innerHTML = "";

    let i = 0;

    const timer = setInterval(() => {

        storyText.innerHTML += text.charAt(i);

        i++;

        if(i >= text.length){
            clearInterval(timer);
        }

    },35);
}


/* Show Story */
function showStory(){

    title.innerHTML = stories[current].title;

    typeText(stories[current].text);

}


/* Next Story */
function nextStory(){

    current++;

    if(current >= stories.length){

        story.style.display = "none";
        end.style.display = "flex";

        createExplosion();

        return;
    }

    title.style.opacity = "0";
    storyText.style.opacity = "0";

    setTimeout(() => {

        title.style.opacity = "1";
        storyText.style.opacity = "1";

        showStory();

    },300);

}


/* Final particle explosion */
function createExplosion(){

    for(let i=0;i<80;i++){

        const p = document.createElement("div");

        p.style.position = "absolute";
        p.style.left = "50%";
        p.style.top = "50%";
        p.style.width = "5px";
        p.style.height = "5px";
        p.style.borderRadius = "50%";

        p.style.background =
            ["#00ffff","#ff00ff","#ffff00","#00ff88"]
            [Math.floor(Math.random()*4)];

        p.style.boxShadow = "0 0 15px currentColor";

        const angle = Math.random()*Math.PI*2;
        const distance = 100 + Math.random()*500;

        p.animate([
            {
                transform:"translate(-50%,-50%) scale(1)",
                opacity:1
            },
            {
                transform:
                `translate(
                    ${Math.cos(angle)*distance}px,
                    ${Math.sin(angle)*distance}px
                ) scale(0)`,
                opacity:0
            }
        ],{
            duration:1800+Math.random()*1200,
            easing:"cubic-bezier(.1,.8,.2,1)"
        });

        document.querySelector(".scene").appendChild(p);

    }

}


/* Mouse / Touch 3D effect */
const card = document.querySelector(".card");

document.addEventListener("mousemove",(e)=>{

    if(story.style.display !== "flex") return;

    const x = (window.innerWidth/2 - e.clientX)/35;
    const y = (window.innerHeight/2 - e.clientY)/35;

    card.style.transform =
        `rotateY(${x}deg) rotateX(${y}deg)`;

});


document.addEventListener("touchmove",(e)=>{

    if(!e.touches[0]) return;

    const x =
        (window.innerWidth/2 - e.touches[0].clientX)/45;

    const y =
        (window.innerHeight/2 - e.touches[0].clientY)/45;

    card.style.transform =
        `rotateY(${x}deg) rotateX(${y}deg)`;

});


</script>

</body>
</html>